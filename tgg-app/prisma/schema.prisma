generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TggPlayer {
  id          String   @id @default(cuid())
  steamId     String?  @unique
  displayName String?
  avatarUrl   String?
  experience  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  telemetry  TggTelemetryEvent[]
  deliveries TggDelivery[]
  clanLinks  TggClanMember[]
  vaultLogs  TggVaultLedger[]
  worldSave  TggWorldSave?
  worldRuns  TggWorldRun[]
}

model TggTelemetryEvent {
  id        String   @id @default(cuid())
  playerId  String?
  eventType String
  payload   Json?
  createdAt DateTime @default(now())

  player TggPlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt])
  @@index([eventType, createdAt])
}

model TggDelivery {
  id          String   @id @default(cuid())
  externalId  String   @unique
  playerId    String?
  productId   String
  status      String
  payload     Json?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  player TggPlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt])
  @@index([status, createdAt])
}

model TggClan {
  id        String   @id
  name      String
  rating    Int      @default(1000)
  metadata  Json?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  members TggClanMember[]
}

model TggClanMember {
  clanId   String
  playerId String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  clan   TggClan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  player TggPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([clanId, playerId])
  @@index([playerId])
}

model TggModerationAction {
  id        String   @id @default(cuid())
  playerId  String
  action    String
  reason    String?
  expiresAt DateTime?
  actor     String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}

model TggMetricSample {
  id        String   @id @default(cuid())
  name      String
  value     Float
  labels    Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}

model TggVaultAccount {
  id        String   @id
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  outgoing TggVaultLedger[] @relation("VaultFrom")
  incoming TggVaultLedger[] @relation("VaultTo")
}

// One row per player: the authoritative server-side TGG World career save.
// `revision` is the optimistic-concurrency counter the browser must echo back,
// so a stale tab cannot overwrite a newer run. `version` is the client save
// schema version, kept so future migrations know what they are reading.
model TggWorldSave {
  id        String   @id @default(cuid())
  playerId  String   @unique
  version   Int      @default(2)
  revision  Int      @default(1)
  bestRunMs Float?
  runs      Int      @default(0)
  career    Json     @default("{}")
  deviceId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  TggPlayer    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  runLogs TggWorldRun[]

  @@index([updatedAt])
}

// Individual completed runs. `id` is supplied by the client so a retried POST
// is idempotent instead of double-counting a run.
model TggWorldRun {
  id        String   @id
  saveId    String
  playerId  String
  totalMs   Float
  legs      Json
  deviceId  String?
  createdAt DateTime @default(now())

  save   TggWorldSave @relation(fields: [saveId], references: [id], onDelete: Cascade)
  player TggPlayer    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId, createdAt])
}

model TggVaultLedger {
  id          String   @id @default(cuid())
  transferId  String   @unique
  fromAccount String
  toAccount   String
  playerId    String?
  amount      BigInt
  memo        String?
  createdAt   DateTime @default(now())

  from   TggVaultAccount @relation("VaultFrom", fields: [fromAccount], references: [id])
  to     TggVaultAccount @relation("VaultTo", fields: [toAccount], references: [id])
  player TggPlayer?      @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([fromAccount, createdAt])
  @@index([toAccount, createdAt])
}
