# TGG Higgsfield service
TGG_HIGGSFIELD_HOST=0.0.0.0
TGG_HIGGSFIELD_PORT=10040
TGG_HIGGSFIELD_ROOT=/data/tgg-higgsfield
TGG_PROJECTS_URL=http://127.0.0.1:10020

# TGG-owned local creative render engine
TGG_CREATIVE_ENGINE_URL=http://127.0.0.1:10041
TGG_HIGGSFIELD_WORKER_INTERVAL_MS=3000
TGG_CREATIVE_ENGINE_POLL_MS=2000
TGG_CREATIVE_ENGINE_HTTP_TIMEOUT_MS=30000
TGG_CREATIVE_ENGINE_JOB_TIMEOUT_MS=1800000

# Provider routing
# local-engine = TGG-owned creative engine (default)
# bridge       = secured TGG provider bridge; requires BOTH URL and token.
TGG_HIGGSFIELD_PROVIDER_MODE=local-engine
# TGG_HIGGSFIELD_PROVIDER_BRIDGE_URL=https://your-tgg-provider-bridge.example
# TGG_HIGGSFIELD_PROVIDER_BRIDGE_TOKEN=configure-outside-git
