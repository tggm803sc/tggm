# TGG Source
TGG_SOURCE_HOST=0.0.0.0
TGG_SOURCE_PORT=10030
TGG_SOURCE_ROOT=/data/tgg-source
TGG_PROJECTS_URL=http://127.0.0.1:10020

# Native Git smart HTTP
# Required for git push. Keep secret outside source control.
TGG_SOURCE_GIT_TOKEN=
# 1 = allow unauthenticated clone/fetch. 0/empty = require the token for reads too.
TGG_SOURCE_GIT_PUBLIC_READ=0

# One-time external import hosts used only for bootstrap/migration.
TGG_SOURCE_IMPORT_HOSTS=github.com,gitlab.com,bitbucket.org

TGG_SOURCE_GIT_NAME=TGG Source
TGG_SOURCE_GIT_EMAIL=source@tgg.local
